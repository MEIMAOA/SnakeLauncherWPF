<?xml version="1.0" encoding="utf-8" ?>
<Application x:Class="SnakeLauncherWPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- ========== ★ 设计系统 Token（Emil Kowalski design-eng 规范） ==========
             近黑文字（不用纯黑）· 半透明细边框（替代硬灰线）· 悬停/按下 120–180ms ease-out ·
             按下缩放 0.97 · 阴影用低不透明度软阴影而不是描边。 -->
        <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#18181B" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C5C66" />
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#8C8C96" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F4F4F6" />
        <SolidColorBrush x:Key="SurfacePressedBrush" Color="#ECECEF" />
        <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#F0F0F3" />
        <SolidColorBrush x:Key="BorderSubtleBrush" Color="#14000000" />
        <SolidColorBrush x:Key="BorderStrongBrush" Color="#26000000" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#140078D4" />
        <SolidColorBrush x:Key="ScrimBrush" Color="#A6000000" />
        <SolidColorBrush x:Key="PositiveBrush" Color="#0F7B4F" />
        <SolidColorBrush x:Key="NegativeBrush" Color="#D13438" />
        <!-- ========== 基础主题画刷（全局） ========== -->
        <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="ForegroundBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#666666" />
        <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="MenuForegroundBrush" Color="#1F1F1F" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#300078D4" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#0078D4" Opacity="0.8" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#C0C0C0" />
        <SolidColorBrush x:Key="TextBoxBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="GroupBoxHeaderBackgroundBrush" Color="#F0F0F0" />

        <!-- ========== ★ 新增：强调色的 hover / pressed / foreground（默认值，运行时会动态覆盖） ========== -->
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#008AF3" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#0060A9" />
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />

        <!-- ========== 按钮中性色资源（浅色默认值） ========== -->
        <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ButtonHoverBackgroundBrush" Color="#F0F0F0" />
        <SolidColorBrush x:Key="ButtonPressedBackgroundBrush" Color="#E0E0E0" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D0D0" />
        <SolidColorBrush x:Key="ButtonNeutralHoverBrush" Color="#20000000" />

        <!-- ========== ★ 鹰角式启动器外壳（固定深色，不随主题切换） ==========
             参考《明日方舟 / 终末地》启动器：深色悬浮侧栏 + 大图主视区 + 右上胶囊 + 右侧工具栏。
             外壳始终使用这套固定色，页面内容仍跟随主题 Token。 -->
        <FontFamily x:Key="DisplayFontFamily">Bahnschrift SemiBold, Bahnschrift, Segoe UI, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="MonoFontFamily">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="IconFontFamily">Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

        <SolidColorBrush x:Key="ShellWindowBrush" Color="#0A0A0C" />
        <SolidColorBrush x:Key="ShellRailBrush" Color="#BF0E0E11" />
        <SolidColorBrush x:Key="ShellGlassBrush" Color="#B8111114" />
        <SolidColorBrush x:Key="ShellGlassStrongBrush" Color="#EF121216" />
        <SolidColorBrush x:Key="ShellCapsuleBrush" Color="#D9141418" />
        <SolidColorBrush x:Key="ShellTextBrush" Color="#F3F3EE" />
        <SolidColorBrush x:Key="ShellTextDimBrush" Color="#A6A6A0" />
        <SolidColorBrush x:Key="ShellTextFaintBrush" Color="#6C6C68" />
        <SolidColorBrush x:Key="ShellHairlineBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="ShellHairlineSoftBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="ShellHoverBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="ShellPressedBrush" Color="#2BFFFFFF" />
        <SolidColorBrush x:Key="ShellScrimBrush" Color="#99000000" />

        <LinearGradientBrush x:Key="ShellArtBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0C1A1B" Offset="0" />
            <GradientStop Color="#0A1214" Offset="0.45" />
            <GradientStop Color="#0B0F10" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ShellArtAccentWashBrush" StartPoint="0,1" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0" />
            <GradientStop Color="#0DFFFFFF" Offset="0.55" />
            <GradientStop Color="#18FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="HeroTitleBrush" StartPoint="0,0" EndPoint="0.2,1">
            <GradientStop Color="#FFFFFFFF" Offset="0" />
            <GradientStop Color="#D8E7E4" Offset="0.55" />
            <GradientStop Color="#8FA5A2" Offset="1" />
        </LinearGradientBrush>

        <DrawingBrush x:Key="DotGridBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,26,26" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#14FFFFFF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="2,2" RadiusX="1.1" RadiusY="1.1" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <DrawingBrush x:Key="LineGridBrush" TileMode="Tile" Stretch="None"
                      Viewport="0,0,72,72" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#0DFFFFFF" Thickness="1" />
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="0,0" EndPoint="72,0" />
                            <LineGeometry StartPoint="0,0" EndPoint="0,72" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- ========== ★ 主视觉 / 面板的明暗两套 Token（运行时由 ThemeManager 覆盖） ========== -->
        <SolidColorBrush x:Key="ShellScrimStrongBrush" Color="#A6000000" />
        <SolidColorBrush x:Key="ShellSunkenBrush" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="ArtGhostTextBrush" Color="#08FFFFFF" />
        <SolidColorBrush x:Key="ArtHighlightBrush" Color="#07FFFFFF" />
        <SolidColorBrush x:Key="ArtMountainBrush1" Color="#0B1415" />
        <SolidColorBrush x:Key="ArtMountainBrush2" Color="#070D0E" />
        <SolidColorBrush x:Key="ArtMountainLineBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="ArtAnnotationBrush" Color="#2EFFFFFF" />
        <SolidColorBrush x:Key="ArtBigNumberBrush" Color="#1AFFFFFF" />
        <SolidColorBrush x:Key="PromoBigNumberBrush" Color="#14FFFFFF" />

        <LinearGradientBrush x:Key="ArtVignetteVerticalBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#8C000000" Offset="0" />
            <GradientStop Color="#26000000" Offset="0.22" />
            <GradientStop Color="#00000000" Offset="0.55" />
            <GradientStop Color="#B3000000" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ArtVignetteHorizontalBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#73000000" Offset="0" />
            <GradientStop Color="#00000000" Offset="0.46" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PromoCardBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#122628" Offset="0" />
            <GradientStop Color="#0B1416" Offset="0.6" />
            <GradientStop Color="#0A0E0F" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SplashProgressTrackBrush" Color="#20FFFFFF" />

        <!-- 滚动条滑块：随明暗主题切换 -->
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="ScrollThumbDragBrush" Color="#99FFFFFF" />

        <!-- 自定义背景可读性压暗层 -->
        <SolidColorBrush x:Key="CustomBackgroundScrimBrush" Color="#4D000000" />

        <!-- ========== SplashWindow 玻璃资源（默认浅色） ========== -->
        <Color x:Key="SplashShadowColor">#1A2A44</Color>

        <LinearGradientBrush x:Key="SplashGlassBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5FFFFFF" Offset="0"/>
            <GradientStop Color="#E0FFFFFF" Offset="0.55"/>
            <GradientStop Color="#CCFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SplashGlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#30FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="SplashBlob1Brush" Color="#5577C4FF"/>
        <SolidColorBrush x:Key="SplashBlob2Brush" Color="#55FFA8C4"/>
        <SolidColorBrush x:Key="SplashTrackBrush" Color="#33FFFFFF"/>
    </Application.Resources>
</Application>