            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource ShellTextFaintBrush}"/>
        </Style>

        <!-- ========== 矢量图标（无需外部字体，缩放不糊） ========== -->
        <Style x:Key="IconStrokePath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style x:Key="IconFillPath" TargetType="Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="Stroke" Value="Transparent"/>
        </Style>

        <Geometry x:Key="IconPlay">M 1,1 L 13,8 L 1,15 Z</Geometry>
        <Geometry x:Key="IconDownload">M 8,1 L 8,11 M 3.5,6.5 L 8,11 L 12.5,6.5 M 1.5,14.5 L 14.5,14.5</Geometry>
        <Geometry x:Key="IconStats">M 2,14 L 2,9 M 6.5,14 L 6.5,4 M 11,14 L 11,7 M 14.5,14 L 14.5,2</Geometry>
        <Geometry x:Key="IconSettings">M 8,1.5 L 8,4 M 8,12 L 8,14.5 M 1.5,8 L 4,8 M 12,8 L 14.5,8 M 3.4,3.4 L 5.1,5.1 M 10.9,10.9 L 12.6,12.6 M 3.4,12.6 L 5.1,10.9 M 10.9,5.1 L 12.6,3.4</Geometry>
        <Geometry x:Key="IconInfo">M 8,1.5 A 6.5,6.5 0 1 1 7.99,1.5 Z M 8,7 L 8,12 M 8,4.4 L 8,4.5</Geometry>
        <Geometry x:Key="IconRefresh">M 13.5,3.5 L 13.5,7 L 10,7 M 13.2,7 A 5.5,5.5 0 1 0 13.4,10.4</Geometry>
        <Geometry x:Key="IconPlus">M 8,2 L 8,14 M 2,8 L 14,8</Geometry>
        <Geometry x:Key="IconFolder">M 1.5,3 L 6,3 L 8,5.5 L 14.5,5.5 L 14.5,13 L 1.5,13 Z</Geometry>
        <Geometry x:Key="IconList">M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12</Geometry>
        <Geometry x:Key="IconUpdate">M 3,12.5 A 6,6 0 0 1 12.6,6 M 13,3.5 L 12.6,6 L 10.1,5.6 M 13,12.5 A 6,6 0 0 0 3.4,6 M 3,3.5 L 3.4,6 L 5.9,5.6</Geometry>
        <Geometry x:Key="IconUser">M 8,1.6 A 3.1,3.1 0 1 1 7.99,1.6 Z M 2,14.2 C 2,10.8 4.6,9.2 8,9.2 C 11.4,9.2 14,10.8 14,14.2</Geometry>
        <Geometry x:Key="IconMessage">M 1.6,3 L 14.4,3 L 14.4,11 L 7.4,11 L 4,13.8 L 4,11 L 1.6,11 Z</Geometry>
        <Geometry x:Key="IconGrid">M 2,2 L 6,2 L 6,6 L 2,6 Z M 10,2 L 14,2 L 14,6 L 10,6 Z M 2,10 L 6,10 L 6,14 L 2,14 Z M 10,10 L 14,10 L 14,14 L 10,14 Z</Geometry>
        <Geometry x:Key="IconClose">M 2,2 L 11,11 M 11,2 L 2,11</Geometry>
        <Geometry x:Key="IconMinimize">M 2,8 L 12,8</Geometry>
        <Geometry x:Key="IconHamburger">M 1,3.5 L 15,3.5 M 1,8 L 15,8 M 1,12.5 L 15,12.5</Geometry>
        <Geometry x:Key="IconChevronRight">M 0,0 L 4.5,5 L 0,10</Geometry>
        <Geometry x:Key="IconChevronDown">M 0,0 L 4,4 L 8,0</Geometry>
    </Window.Resources>
    <!-- ==================================================================
         ★ 鹰角式启动器窗口骨架
         深色悬浮侧栏 · 满幅主视觉 · 右上胶囊栏 · 右侧工具栏 · 右下开始按钮
         根节点保持 Border → Grid 结构（运行时对话框依赖该结构）
         ================================================================== -->
    <Border CornerRadius="32" Margin="12" Background="{StaticResource ShellWindowBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="44" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid x:Name="RootGrid" ClipToBounds="True">

            <!-- ============ A. 主视觉（Viewbox 等比铺满，保证任意窗口尺寸构图不变形） ============ -->
            <!-- ============ A0. 自定义启动器背景（图片 / 视频，可在设置中选择） ============ -->
            <!-- ============ A. 内容区：与左侧导航栏分离的独立圆角面板 ============ -->
            <Grid x:Name="ContentBackdrop" Margin="88,12,12,12" IsHitTestVisible="False">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,1200,700" RadiusX="20" RadiusY="20"/>
                </Grid.Clip>

            <Grid x:Name="CustomBackgroundLayer" IsHitTestVisible="False" Visibility="Collapsed">
                <Image x:Name="CustomBackgroundImage" Stretch="UniformToFill"/>
                <Rectangle x:Name="CustomBackgroundVideoRect" Visibility="Collapsed"/>
                <Border x:Name="CustomBackgroundScrim" Background="{DynamicResource CustomBackgroundScrimBrush}"/>
            </Grid>

            <Grid x:Name="ArtLayer" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource ShellArtBrush}"/>

                <Viewbox Stretch="UniformToFill">
                    <Canvas Width="1200" Height="720">
                        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1200" Height="720" Fill="{StaticResource ShellArtBrush}"/>

                        <!-- 斜向高光带 -->
                        <Polygon Points="0,560 1200,240 1200,400 0,700" Fill="{StaticResource ArtHighlightBrush}"/>

                        <!-- 强调色光晕：日出 -->
                        <Ellipse Canvas.Left="690" Canvas.Top="30" Width="540" Height="540"
                                 Fill="{DynamicResource AccentBrush}" Opacity="0.15">
                            <Ellipse.Effect>
                                <BlurEffect Radius="150"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Canvas.Left="872" Canvas.Top="176" Width="176" Height="176"
                                 Fill="{DynamicResource AccentBrush}" Opacity="0.30">
                            <Ellipse.Effect>
                                <BlurEffect Radius="46"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- 细网格 / 点阵 -->
                        <Rectangle Canvas.Left="540" Canvas.Top="0" Width="660" Height="720"
                                   Fill="{StaticResource LineGridBrush}" Opacity="0.55">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="1,0" EndPoint="0,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <Rectangle Canvas.Left="620" Canvas.Top="352" Width="520" Height="368"
                                   Fill="{StaticResource DotGridBrush}" Opacity="0.75">
                            <Rectangle.OpacityMask>
                                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                    <GradientStop Color="#88FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.OpacityMask>
                        </Rectangle>

                        <!-- 幽灵大字 -->
                        <TextBlock Canvas.Left="436" Canvas.Top="96" Text="SNAKE"
                                   FontFamily="{DynamicResource DisplayFontFamily}" FontSize="352"
                                   FontWeight="Bold" Foreground="{StaticResource ArtGhostTextBrush}"
                                   TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"/>

                        <!-- 远景山脉 -->
                        <Path Data="M 0,600 L 120,470 L 244,558 L 396,418 L 544,578 L 704,452 L 864,562 L 1014,468 L 1200,584 L 1200,720 L 0,720 Z"
                              Fill="{StaticResource ArtMountainBrush1}" Opacity="0.92"/>
                        <Path Data="M 0,652 L 198,544 L 382,640 L 600,518 L 802,640 L 1002,558 L 1200,650 L 1200,720 L 0,720 Z"
                              Fill="{StaticResource ArtMountainBrush2}" Opacity="0.95"/>
                        <Path Data="M 0,652 L 198,544 L 382,640 L 600,518 L 802,640 L 1002,558 L 1200,650"
                              Stroke="{StaticResource ArtMountainLineBrush}" StrokeThickness="1.1"/>

                        <!-- 蛇形光带：外发光 → 主线 → 内高光 → 虚线示意 -->
                        <Path Data="M 1250,548 C 1040,474 1092,332 906,300 C 742,272 690,424 540,394 C 398,366 432,218 300,178 C 238,160 188,188 148,214"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="16"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.30">
                            <Path.Effect>
                                <BlurEffect Radius="30"/>
                            </Path.Effect>
                        </Path>
                        <Path Data="M 1250,548 C 1040,474 1092,332 906,300 C 742,272 690,424 540,394 C 398,366 432,218 300,178 C 238,160 188,188 148,214"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path Data="M 1250,548 C 1040,474 1092,332 906,300 C 742,272 690,424 540,394 C 398,366 432,218 300,178 C 238,160 188,188 148,214"
                              Stroke="#D9FFFFFF" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.85"/>
                        <Path Data="M 1250,548 C 1040,474 1092,332 906,300 C 742,272 690,424 540,394 C 398,366 432,218 300,178 C 238,160 188,188 148,214"
                              Stroke="#80FFFFFF" StrokeThickness="1.1" StrokeDashArray="0.6 3.4"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                        <!-- 蛇头（几何化） -->
                        <Path Data="M 148,214 L 124,194 C 115,186 119,174 131,172 L 168,169 C 182,168 188,177 183,188 L 173,212 Z"
                              Fill="{DynamicResource AccentBrush}"/>
                        <Ellipse Canvas.Left="158" Canvas.Top="181" Width="5.6" Height="5.6" Fill="#141412"/>

                        <!-- 光点 -->
                        <Ellipse Canvas.Left="1010" Canvas.Top="470" Width="4" Height="4" Fill="{DynamicResource AccentBrush}" Opacity="0.8"/>
                        <Ellipse Canvas.Left="760" Canvas.Top="150" Width="3" Height="3" Fill="#FFFFFFFF" Opacity="0.45"/>
                        <Ellipse Canvas.Left="564" Canvas.Top="250" Width="2.4" Height="2.4" Fill="#FFFFFFFF" Opacity="0.35"/>
                        <Ellipse Canvas.Left="330" Canvas.Top="460" Width="3.4" Height="3.4" Fill="{DynamicResource AccentBrush}" Opacity="0.55"/>

                        <!-- 技术标注（避开左上字标区域） -->
                        <TextBlock Canvas.Left="700" Canvas.Top="66" Text="SNAKE // LAUNCHER CORE"
                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="10"
                                   Foreground="{StaticResource ArtAnnotationBrush}" TextOptions.TextFormattingMode="Ideal"/>
                        <TextBlock Canvas.Left="1120" Canvas.Top="112" Text="05"
                                   FontFamily="{DynamicResource DisplayFontFamily}" FontSize="26"
                                   Foreground="{StaticResource ArtBigNumberBrush}" TextOptions.TextFormattingMode="Ideal"/>

                        <!-- 缓慢漂移的氛围光球（BgBlob1..3 由代码驱动漂移） -->
                        <Ellipse x:Name="BgBlob1" Canvas.Left="150" Canvas.Top="250" Width="380" Height="380"
                                 Fill="{DynamicResource AccentBrush}" Opacity="0.07">
                            <Ellipse.Effect>
                                <BlurEffect Radius="90"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="BgBlob1Transform" X="0" Y="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="BgBlob2" Canvas.Left="720" Canvas.Top="60" Width="300" Height="300"
                                 Fill="#FF7EB6" Opacity="0.05">
                            <Ellipse.Effect>
                                <BlurEffect Radius="90"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="BgBlob2Transform" X="0" Y="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="BgBlob3" Canvas.Left="940" Canvas.Top="430" Width="340" Height="340"
                                 Fill="{DynamicResource AccentBrush}" Opacity="0.06">
                            <Ellipse.Effect>
                                <BlurEffect Radius="90"/>
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="BgBlob3Transform" X="0" Y="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- 可读性遮罩：自定义背景与默认主视觉共用 -->
            <Grid x:Name="LegibilityLayer" IsHitTestVisible="False">
                <Rectangle Fill="{StaticResource ArtVignetteVerticalBrush}"/>
                <Rectangle Fill="{StaticResource ArtVignetteHorizontalBrush}"/>
            </Grid>

            </Grid>
            <!-- ============ A-End. 内容区圆角面板结束 ============ -->

            <!-- ============ B. 无边框窗口拖拽热区 ============ -->
            <Grid Height="48" VerticalAlignment="Top" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

            <!-- ============ C. 外壳 ============ -->
            <Grid Margin="12,12,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- C1. 左侧深色导航栏 -->
                <Border x:Name="LeftRail" Grid.Column="0" CornerRadius="20"
                        Background="{StaticResource ShellRailBrush}"
                        Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 品牌标记：环绕的蛇 -->
                        <StackPanel Grid.Row="0" Margin="0,16,0,8" HorizontalAlignment="Center">
                            <Viewbox Width="34" Height="34" HorizontalAlignment="Center">
                                <Canvas Width="34" Height="34">
                                    <Ellipse Canvas.Left="1" Canvas.Top="1" Width="32" Height="32"
                                             Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Opacity="0.9"/>
                                    <Path Data="M 21,10.5 C 21,7.4 17.2,6.3 14.6,7.8 C 12,9.3 12.6,12.4 15.6,13.7 C 18.6,15 19.6,18 17,20 C 14.4,22 10.6,21 9.6,18.4"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.9"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Canvas.Left="19.6" Canvas.Top="9" Width="3" Height="3"
                                             Fill="{DynamicResource AccentBrush}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="SNAKE" FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="8" FontWeight="SemiBold"
                                       Foreground="{StaticResource ShellTextDimBrush}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>

                        <!-- 导航项 -->
                        <Grid Grid.Row="1" VerticalAlignment="Top" Margin="0,6,0,0">
                            <Border x:Name="TabSlider" Width="3" Height="24" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="6,20,0,0" Opacity="0.95"/>
                            <StackPanel Margin="0,0,0,0">
                                <Button x:Name="BtnTabLaunch" Style="{StaticResource RailNavButton}" Tag="Selected"
                                        Click="TabButton_Click" ToolTip="启动">
                                    <StackPanel>
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource IconFillPath}" Data="{StaticResource IconPlay}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtNavLaunch" Text="启动" FontSize="9.5" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnTabStats" Style="{StaticResource RailNavButton}" Tag="Unselected"
                                        Click="TabButton_Click" ToolTip="数据">
                                    <StackPanel>
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconStats}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtNavStats" Text="数据" FontSize="9.5" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnTabSettings" Style="{StaticResource RailNavButton}" Tag="Unselected"
                                        Click="TabButton_Click" ToolTip="设置">
                                    <StackPanel>
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconSettings}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtNavSettings" Text="设置" FontSize="9.5" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnTabAbout" Style="{StaticResource RailNavButton}" Tag="Unselected"
                                        Click="TabButton_Click" ToolTip="关于">
                                    <StackPanel>
                                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center">
                                            <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconInfo}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtNavAbout" Text="关于" FontSize="9.5" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 底部：版本库 -->
                        <Button x:Name="BtnAllGames" Grid.Row="2" Style="{StaticResource UtilityButton}"
                                Margin="0,0,0,14" HorizontalAlignment="Center"
                                Click="BtnAllGames_Click" ToolTip="版本库">
                            <Viewbox Width="19" Height="19">
                                <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconGrid}"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                </Border>

                <!-- C2. 主视区 -->
                <Grid Grid.Column="1">

                    <!-- ===== 首页主视觉内容 ===== -->
                    <Grid x:Name="HomeLayer">
                        <!-- 左上品牌字标 -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="26,22,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="7" Height="7" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="SNAKE LAUNCHER" FontFamily="{DynamicResource DisplayFontFamily}"
                                           FontSize="10.5" Foreground="{StaticResource ShellTextDimBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  /  " FontSize="10"
                                           Foreground="{StaticResource ShellTextFaintBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtHomeBadge" Text="OFFICIAL" FontSize="10"
                                           Foreground="{StaticResource ShellTextFaintBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtAppTitle" Text="贪吃蛇启动器" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource ShellTextBrush}" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtHomeTagline" Text="把每一次出发，都变成一次冒险。"
                                       FontSize="11.5" Foreground="{StaticResource ShellTextDimBrush}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- 中部主标题 -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="30,0,0,52">
                            <TextBlock x:Name="TxtHeroKicker" Text="SNAKE  //  SANCTUARY OF CODE"
                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="10.5"
                                       Foreground="{DynamicResource AccentBrush}" Margin="2,0,0,12"/>
                            <TextBlock x:Name="TxtHeroTitle" Text="贪吃蛇"
                                       FontFamily="{DynamicResource DisplayFontFamily}"
                                       FontSize="94" FontWeight="Bold"
                                       Foreground="{StaticResource HeroTitleBrush}">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="4" Opacity="0.35" Color="#000000"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="4,4,0,0">
                                <TextBlock x:Name="TxtHeroEn" Text="T H E   S N A K E"
                                           FontFamily="{DynamicResource DisplayFontFamily}" FontSize="20"
                                           Foreground="{StaticResource ShellTextBrush}"/>
                                <Border Width="52" Height="2" Background="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.9"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="4,18,0,0">
                                <Border CornerRadius="8" Padding="10,4" Background="{StaticResource ShellCapsuleBrush}"
                                        BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="HomeStatusDot" Width="6" Height="6" Fill="{DynamicResource PositiveBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="TxtHomeVersion" Text="当前版本 v6.0.0" FontSize="11"
                                                   Foreground="{StaticResource ShellTextBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Padding="10,4" Margin="8,0,0,0"
                                        Background="{StaticResource ShellCapsuleBrush}"
                                        BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1">
                                    <TextBlock x:Name="TxtHomeLatest" Text="已是最新版本" FontSize="11"
                                               Foreground="{StaticResource ShellTextDimBrush}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- 底部：版本资讯 + 公告 + 开始游戏 -->
                        <Grid VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                              Margin="26,0,72,28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="238"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 版本资讯卡（缩略主视觉） -->
                            <Border x:Name="PromoCard" Grid.Column="0" Height="170" CornerRadius="16"
                                    Background="{StaticResource ShellGlassBrush}"
                                    BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1"
                                    MouseLeftButtonUp="PromoCard_MouseLeftButtonUp" Cursor="Hand">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,238,170" RadiusX="16" RadiusY="16"/>
                                </Border.Clip>
                                <Grid>
                                    <Rectangle Fill="{StaticResource PromoCardBackgroundBrush}"/>
                                    <Ellipse Width="150" Height="150" HorizontalAlignment="Right"
                                             VerticalAlignment="Top" Margin="0,-46,-40,0"
                                             Fill="{DynamicResource AccentBrush}" Opacity="0.16">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="48"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <Path Data="M 178,150 C 140,132 158,96 112,88 C 68,80 62,116 30,104"
                                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.9"/>
                                    <Path Data="M 178,150 C 140,132 158,96 112,88 C 68,80 62,116 30,104"
                                          Stroke="#99FFFFFF" StrokeThickness="1" StrokeDashArray="0.6 2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <TextBlock Text="05" FontFamily="{DynamicResource DisplayFontFamily}"
                                               FontSize="48" Foreground="{StaticResource PromoBigNumberBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="0,10,16,0"/>

                                    <Button x:Name="BtnPromoDetail" Content="查看详情 ›"
                                            Style="{StaticResource PromoLinkButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,12,12,0"
                                            Click="BtnPromoDetail_Click"/>

                                    <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                        <TextBlock x:Name="TxtPromoKicker" Text="VERSION INFO"
                                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="9"
                                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtPromoTitle" Text="版本资讯" FontSize="16"
                                                   FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}"/>
                                        <TextBlock x:Name="TxtPromoDesc" Text="v6.0.0 · 已安装"
                                                   FontSize="10.5" Foreground="{StaticResource ShellTextDimBrush}"
                                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 公告 / 新闻 / 资讯 -->
                            <Border x:Name="NewsPanel" Grid.Column="1" Height="170" Width="470"
                                    Margin="12,0,0,0" CornerRadius="16"
                                    Background="{StaticResource ShellGlassBrush}"
                                    BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1">
                                <Grid Margin="18,13,16,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" Grid.Column="0">
                                            <TextBlock x:Name="TxtNewsTab1" Text="公告" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Cursor="Hand" Tag="0" MouseLeftButtonUp="NewsTab_Click"/>
                                            <TextBlock x:Name="TxtNewsTab2" Text="新闻" FontSize="12.5"
                                                       Foreground="{StaticResource ShellTextDimBrush}" Margin="20,0,0,0"
                                                       Cursor="Hand" Tag="1" MouseLeftButtonUp="NewsTab_Click"/>
                                            <TextBlock x:Name="TxtNewsTab3" Text="资讯" FontSize="12.5"
                                                       Foreground="{StaticResource ShellTextDimBrush}" Margin="20,0,0,0"
                                                       Cursor="Hand" Tag="2" MouseLeftButtonUp="NewsTab_Click"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" x:Name="TxtMore" Text="更多 ›" FontSize="11"
                                                   Foreground="{StaticResource ShellTextFaintBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Cursor="Hand" MouseLeftButtonUp="MoreAnnouncements_Click"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" Margin="0,4,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="AnnouncementList"/>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- 开始游戏（药丸 + 右侧菜单） -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <TextBlock x:Name="TxtHomeStatus" Text="已就绪 · 点击开始"
                                           FontSize="11" Foreground="{StaticResource ShellTextDimBrush}"
                                           HorizontalAlignment="Right" Margin="0,0,6,9"/>
                                <Border x:Name="StartPill" Style="{StaticResource StartPillStyle}" Height="68">
                                    <Grid MinWidth="272">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 运行中：灰色遮罩（文字/图标位于其上方） -->
                                        <Border x:Name="StartPillGreyOverlay" Grid.ColumnSpan="3"
                                                CornerRadius="17" Background="#E63B3B42"
                                                Opacity="0" Visibility="Collapsed"
                                                IsHitTestVisible="False"/>

                                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#22000000" BorderBrush="#40FFFFFF" BorderThickness="1">
                                            <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconPlay}"
                                                      Fill="{DynamicResource AccentForegroundBrush}"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="TxtStartGame" Text="开始游戏" FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentForegroundBrush}"/>
                                            <TextBlock x:Name="TxtStartVersion" Text="v6.0.0" FontSize="10.5"
                                                       Foreground="{DynamicResource AccentForegroundBrush}"
                                                       Opacity="0.72" Margin="1,2,0,0"/>
                                        </StackPanel>

                                        <Border Grid.Column="2" Width="1" Height="30" HorizontalAlignment="Left"
                                                Background="#2E000000" VerticalAlignment="Center"/>

                                        <Button x:Name="BtnStartGame" Grid.Column="0" Grid.ColumnSpan="2"
                                                Style="{StaticResource PillPartButton}"
                                                Click="BtnStartGame_Click" ToolTip="启动当前版本"/>
                                        <Button x:Name="BtnStartMenu" Grid.Column="2"
                                                Style="{StaticResource PillPartButton}"
                                                Click="BtnStartMenu_Click" ToolTip="版本库">
                                            <Viewbox Width="19" Height="19">
                                                <Path Stroke="{DynamicResource AccentForegroundBrush}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Data="{StaticResource IconHamburger}"/>
                                            </Viewbox>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- ===== 子页面（下载 / 数据 / 设置 / 关于）===== -->
                    <Grid x:Name="PagesLayer" Visibility="Collapsed">
                        <Border x:Name="PageScrim" Background="{StaticResource ShellScrimBrush}"/>

                        <Border x:Name="PageHost" Margin="26,66,88,34" CornerRadius="22"
                                Background="{StaticResource ShellGlassStrongBrush}"
                                BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="42" ShadowDepth="14" Opacity="0.5" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 页头 -->
                                <Grid Grid.Row="0" Margin="20,13,14,9">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                            <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconSettings}"
                                                  Stroke="{DynamicResource AccentBrush}"/>
                                        </Viewbox>
                                        <TextBlock x:Name="TxtPageKicker" Text="LAUNCHER" Style="{StaticResource ShellKicker}"
                                                   VerticalAlignment="Center" Margin="9,0,9,0"/>
                                        <TextBlock x:Name="TxtPageTitle" Text="设置" FontSize="15.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button x:Name="BtnClosePage" Style="{StaticResource WindowIconButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Click="BtnClosePage_Click" ToolTip="返回">
                                        <Viewbox Width="12" Height="12">
                                            <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconClose}"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>

                                <!-- 主体：设置导航 + 页面内容 -->
                                <Grid Grid.Row="1" Margin="16,0,12,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel x:Name="SettingsNav" Grid.Column="0" Width="176"
                                                Margin="0,0,14,0" Visibility="Collapsed">
                                        <Border CornerRadius="12" Padding="6"
                                                Background="{StaticResource ShellSunkenBrush}"
                                                BorderBrush="{StaticResource ShellHairlineSoftBrush}"
                                                BorderThickness="1">
                                            <StackPanel>
                                                <Button x:Name="BtnNavLauncher" Style="{StaticResource SettingsNavItem}"
                                                        Content="启动器设置" Tag="Selected"
                                                        Click="SettingsNavLauncher_Click"/>
                                                <Button x:Name="BtnNavAbout" Style="{StaticResource SettingsNavItem}"
                                                        Content="关于" Click="SettingsNavAbout_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock x:Name="TxtSettingsVersion" Margin="8,14,0,0" FontSize="10"
                                                   FontFamily="{DynamicResource MonoFontFamily}"
                                                   Foreground="{StaticResource ShellTextFaintBrush}"/>
                                    </StackPanel>

                                    <Grid x:Name="ContentGrid" Grid.Column="1"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ===== 右侧工具栏 ===== -->
                    <StackPanel x:Name="UtilityRail" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0">
                        <Button x:Name="BtnUtilLibrary" Style="{StaticResource UtilityButton}"
                                Click="BtnUtilLibrary_Click" ToolTip="版本库">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconList}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnUtilRefresh" Style="{StaticResource UtilityButton}"
                                Click="BtnUtilRefresh_Click" ToolTip="刷新版本列表">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconRefresh}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnUtilAdd" Style="{StaticResource UtilityButton}"
                                Click="BtnUtilAdd_Click" ToolTip="手动添加游戏">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconPlus}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnUtilFolder" Style="{StaticResource UtilityButton}"
                                Click="BtnUtilFolder_Click" ToolTip="打开游戏目录">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconFolder}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnUtilUpdate" Style="{StaticResource UtilityButton}"
                                Click="BtnUtilUpdate_Click" ToolTip="检查更新">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconUpdate}"/>
                            </Viewbox>
                        </Button>
                        <Button x:Name="BtnUtilAbout" Style="{StaticResource UtilityButton}"
                                Click="BtnUtilAbout_Click" ToolTip="关于">
                            <Viewbox Width="18" Height="18">
                                <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconInfo}"/>
                            </Viewbox>
                        </Button>
                    </StackPanel>

                    <!-- ===== 右上胶囊栏 ===== -->
                    <StackPanel x:Name="TopCapsule" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,12,0">
                        <Border Background="{StaticResource ShellCapsuleBrush}" CornerRadius="15" Padding="5,3"
                                BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnAccount" Style="{StaticResource CapsuleButton}"
                                        Click="BtnAccount_Click" ToolTip="本地账号">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="24" Height="24" CornerRadius="12"
                                                Background="{DynamicResource AccentSoftBrush}">
                                            <Viewbox Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconUser}"
                                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5"
                                                      Fill="Transparent" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                            </Viewbox>
                                        </Border>
                                        <TextBlock x:Name="TxtAccount" Text="本地用户" FontSize="12"
                                                   Foreground="{StaticResource ShellTextBrush}"
                                                   VerticalAlignment="Center" Margin="8,0,6,0"/>
                                        <Viewbox Width="9" Height="9" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconChevronDown}" Stroke="{StaticResource ShellTextDimBrush}"
                                                  StrokeThickness="1.4" Fill="Transparent"/>
                                        </Viewbox>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnMessages" Style="{StaticResource CapsuleButton}"
                                        Click="BtnMessages_Click" ToolTip="消息">
                                    <Viewbox Width="17" Height="17">
                                        <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconMessage}"/>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource ShellCapsuleBrush}" CornerRadius="15" Padding="4,3"
                                BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnSettings" Style="{StaticResource WindowIconButton}"
                                        Click="BtnSettings_Click" ToolTip="设置">
                                    <Viewbox Width="15" Height="15">
                                        <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconSettings}"/>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="BtnMinimizeWindow" Style="{StaticResource WindowIconButton}"
                                        Click="Minimize_Click" ToolTip="最小化">
                                    <Viewbox Width="12" Height="12">
                                        <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconMinimize}"/>
                                    </Viewbox>
                                </Button>
                                <Button x:Name="BtnCloseWindow" Style="{StaticResource WindowIconButton}"
                                        Click="Close_Click" ToolTip="关闭">
                                    <Viewbox Width="12" Height="12">
                                        <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconClose}"/>
                                    </Viewbox>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===== 版本库抽屉 ===== -->
                    <Border x:Name="LibraryOverlay" Visibility="Collapsed" Background="{StaticResource ShellScrimBrush}"
                            MouseLeftButtonDown="LibraryOverlay_MouseLeftButtonDown">
                        <Border x:Name="LibraryPanel" Width="564" CornerRadius="22"
                                HorizontalAlignment="Right" Margin="0,0,4,0"
                                Background="{StaticResource ShellGlassStrongBrush}"
                                BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="46" ShadowDepth="16" Opacity="0.55" Color="#000000"/>
                            </Border.Effect>
                            <Grid Margin="22,18,20,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLibraryKicker" Text="VERSION LIBRARY"
                                                   Style="{StaticResource ShellKicker}"/>
                                        <TextBlock x:Name="TxtLibraryTitle" Text="版本库" FontSize="22"
                                                   FontWeight="SemiBold" Foreground="{StaticResource ShellTextBrush}"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock x:Name="TxtLibraryDesc" Text="选择要启动的版本，或查看每个版本的详情"
                                                   FontSize="11.5" Foreground="{StaticResource ShellTextDimBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel x:Name="LibrarySortHost" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,32,42,0"/>
                                    <Button x:Name="BtnCloseLibrary" Style="{StaticResource WindowIconButton}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Click="BtnCloseLibrary_Click" ToolTip="关闭">
                                        <Viewbox Width="12" Height="12">
                                            <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconClose}"/>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                                <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="LibraryList"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- ===== 运行状态条（游戏运行时显示） ===== -->
                    <Border x:Name="IpcStatusBar" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,72,0,0" Visibility="Collapsed"
                            Background="{StaticResource ShellCapsuleBrush}"
                            BorderBrush="{StaticResource ShellHairlineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtIpcFpsLabel" Text="FPS: " Foreground="{StaticResource ShellTextDimBrush}"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtFps" Text="--" Foreground="{StaticResource ShellTextBrush}"
                                       FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtIpcScoreLabel" Text="得分: " Foreground="{StaticResource ShellTextDimBrush}"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtScore" Text="0" Foreground="{StaticResource ShellTextBrush}"
                                       FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtIpcKillsLabel" Text="击杀: " Foreground="{StaticResource ShellTextDimBrush}"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtKills" Text="0" Foreground="{StaticResource ShellTextBrush}"
                                       FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtIpcModeLabel" Text="模式: " Foreground="{StaticResource ShellTextDimBrush}"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtMode" Text="--" Foreground="{StaticResource ShellTextBrush}"
                                       FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock x:Name="TxtIpcTimeLabel" Text="时长: " Foreground="{StaticResource ShellTextDimBrush}"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlayTime" Text="00:00:00" Foreground="{StaticResource ShellTextBrush}"
                                       FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <TextBlock x:Name="TxtIpcConnLabel" Text="连接: " Foreground="{StaticResource ShellTextDimBrush}"
                                       FontSize="11.5" VerticalAlignment="Center"/>
                            <Ellipse x:Name="StatusLight" Width="8" Height="8" Fill="Gray"
                                     VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBlock x:Name="TxtStatus" Text="未连接" Foreground="{StaticResource ShellTextBrush}"
                                       FontSize="11.5" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ D. 通知横条 ============ -->
            <Border x:Name="NotificationBar"
                    Background="{StaticResource ShellGlassStrongBrush}"
                    BorderBrush="{StaticResource ShellHairlineBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,104,126"
                    Padding="16,12"
                    MinWidth="180"
                    MaxWidth="460"
                    Opacity="0"
                    RenderTransformOrigin="1,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NotificationTransform" X="300"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" Margin="0,2,0,2"/>
                    <TextBlock x:Name="NotificationText" Text="" Grid.Column="1" Margin="12,0,0,0"
                               Foreground="{StaticResource ShellTextBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextWrapping="Wrap" LineHeight="19"/>
                </Grid>
            </Border>

            <!-- ============ E. 详情弹窗 ============ -->
            <Border x:Name="DetailOverlay" Background="{StaticResource ShellScrimStrongBrush}" Visibility="Collapsed"
                    MouseLeftButtonDown="DetailOverlay_MouseLeftButtonDown">
                <Border x:Name="DetailPanel"
                        Background="{StaticResource ShellGlassStrongBrush}"
                        BorderBrush="{StaticResource ShellHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="22"
                        Width="640" Height="470"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="DetailScale" ScaleX="0.96" ScaleY="0.96"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="46" ShadowDepth="16" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>
                                <TextBlock x:Name="DetailTitle" Text="详情" FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource ShellTextBrush}"/>
                            </StackPanel>
                            <Button Style="{StaticResource WindowIconButton}"
                                    HorizontalAlignment="Right" Click="CloseDetailPanel_Click" ToolTip="关闭">
                                <Viewbox Width="12" Height="12">
                                    <Path Style="{StaticResource IconStrokePath}" Data="{StaticResource IconClose}"/>
                                </Viewbox>
                            </Button>
                        </Grid>
                        <TextBox x:Name="DetailTextBox" Grid.Row="1"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource ShellSunkenBrush}"
                                 Foreground="{StaticResource ShellTextBrush}"
                                 BorderBrush="{StaticResource ShellHairlineBrush}"
                                 BorderThickness="1"
                                 FontSize="12.5"/>
                        <Grid Grid.Row="2" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOpenFolder"
                                    Grid.Column="0"
                                    Content="打开所在文件夹"
                                    Style="{StaticResource RoundedButton}"
                                    Width="150" Height="38"
                                    HorizontalAlignment="Left"
                                    Click="BtnOpenFolder_Click"/>
                            <Button x:Name="BtnDeleteGame"
                                    Grid.Column="1"
                                    Content="删除此游戏"
                                    Width="128" Height="38"
                                    Cursor="Hand"
                                    FontWeight="SemiBold"
                                    Click="BtnDeleteGame_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Border" Background="#D13438" CornerRadius="9">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#B02C30"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#8A2024"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Foreground>
                                    <SolidColorBrush Color="White"/>
                                </Button.Foreground>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Border>

            <!-- 开始按钮右侧三条杠菜单 -->
            <Popup x:Name="GameMenuPopup" Placement="Top"
                   PlacementTarget="{Binding ElementName=BtnStartMenu}"
                   StaysOpen="False" AllowsTransparency="True"
                   VerticalOffset="-10" HorizontalOffset="40">
                <Border Background="{StaticResource ShellGlassStrongBrush}"
                        BorderBrush="{StaticResource ShellHairlineBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="6"
                        MinWidth="212">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button x:Name="BtnMenuGameSettings" Style="{StaticResource GameMenuItemStyle}"
                                Content="游戏设置" Click="GameMenuSettings_Click"/>
                        <Button x:Name="BtnMenuShortcut" Style="{StaticResource GameMenuItemStyle}"
                                Content="添加桌面快捷方式" Click="GameMenuShortcut_Click"/>
                        <Button x:Name="BtnMenuVerify" Style="{StaticResource GameMenuItemStyle}"
                                Content="游戏完整性检查" Click="GameMenuVerify_Click"/>
                        <Button x:Name="BtnMenuClearCache" Style="{StaticResource GameMenuItemStyle}"
                                Content="清理下载缓存" Click="GameMenuClearCache_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>
