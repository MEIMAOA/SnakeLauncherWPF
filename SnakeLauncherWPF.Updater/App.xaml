<Application x:Class="SnakeLauncherWPF.Updater.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- ============================================ -->
        <!-- 默认资源（浅色），App.xaml.cs 会根据参数覆盖 -->
        <!-- ============================================ -->

        <!-- 标题 / 副标题 -->
        <SolidColorBrush x:Key="TitleForegroundBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="SubtitleForegroundBrush" Color="#666666"/>

        <!-- 状态文字 -->
        <SolidColorBrush x:Key="StatusForegroundBrush" Color="#1F1F1F"/>
        <SolidColorBrush x:Key="PercentForegroundBrush" Color="#666666"/>
        <SolidColorBrush x:Key="ErrorForegroundBrush" Color="#D13438"/>

        <!-- 进度条 -->
        <SolidColorBrush x:Key="ProgressTrackBrush" Color="#22000000"/>
        <SolidColorBrush x:Key="ProgressFillBrush" Color="#0078D4"/>

        <!-- 按钮 -->
        <SolidColorBrush x:Key="SecondaryButtonBackgroundBrush" Color="#22000000"/>
        <SolidColorBrush x:Key="SecondaryButtonForegroundBrush" Color="#1F1F1F"/>

        <!-- 玻璃背景（浅色） -->
        <LinearGradientBrush x:Key="GlassBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F5FFFFFF" Offset="0"/>
            <GradientStop Color="#E0FFFFFF" Offset="0.55"/>
            <GradientStop Color="#CCFFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFFF" Offset="0"/>
            <GradientStop Color="#30FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <Color x:Key="ShadowColor">#1A2A44</Color>

        <!-- 背景装饰光斑 -->
        <SolidColorBrush x:Key="Blob1Brush" Color="#5577C4FF"/>
        <SolidColorBrush x:Key="Blob2Brush" Color="#55FFA8C4"/>
    </Application.Resources>
</Application>